# ==========================================
# APP SETTINGS (FastAPI / Uvicorn)
# ==========================================
ENVIRONMENT="development"
API_HOST="0.0.0.0"
API_PORT="8080"

# ==========================================
# WEB LOGIN (browser session for /app, /analytics and /knowledge-base)
# ==========================================
# Required: at least 32 random bytes from the secret manager. Startup fails without it.
WEB_SESSION_SECRET=
# Required: the exact external HTTPS origin users open, such as https://chat.example.com (no path). Startup fails without it.
WEB_PUBLIC_ORIGIN=
WEB_COOKIE_MODE=https
WEB_ENVIRONMENT=production
WEB_SESSION_SECONDS=900

# ==========================================
# VECTOR DATABASE (Qdrant)
# ==========================================
QDRANT_URL="http://10.0.1.7:6333"
QDRANT_HOST="10.0.1.7"
QDRANT_PORT="6333"
QDRANT_API_KEY=
QDRANT_COLLECTION=
QDRANT_VECTOR_SIZE="1024"
QDRANT_HTTPS="False"

# ==========================================
# DATABASE CONFIGURATION
# ==========================================
POSTGRES_HOST="10.4.8.2"
POSTGRES_PORT="5432"
POSTGRES_DB="chatbot"
POSTGRES_USER=
POSTGRES_PASSWORD=

DEFAULT_DB_HOST="10.4.8.2"
DEFAULT_DB_PORT="5432"
DEFAULT_DB_USER=
DEFAULT_DB_PASSWORD=
DEFAULT_DB_NAME=

# ==========================================
# OBJECT STORAGE (MinIO)
# ==========================================
MINIO_ENDPOINT="10.0.1.44:9057"
MINIO_ACCESS_KEY=
MINIO_SECRET_KEY=
MINIO_SECURE="False"
MINIO_BUCKET=

# ==========================================
# MODEL AND DATA PATHS
# ==========================================
EMBEDDING_MODEL="/u01/models/hub/models--jinaai--jina-embeddings-v5-text-small-retrieval"
QUERY_EMBEDDING_MODEL="/u01/models/hub/models--jinaai--jina-embeddings-v5-text-small-retrieval"
LLM_MODEL="gemma-4-12B-it"
RERANKER_MODEL="/u01/models/hub/BAAI--bge-reranker-v2-m3"
KNOWLEDGE_BASE_CSV="/u01/chat-bot-data/General_FAQ.csv"
DATA_INSERTION_DIRECTORY="/u01/chat-bot-data/data_insertion_chunks"

# ==========================================
# INFERENCE SERVICE ENDPOINTS
# ==========================================
VLLM_URL="http://localhost:8000/v1"
TEI_EMBED_URL="http://localhost:7997"
INTENT_CLASSIFIER_MODEL_PATH="/u01/models/ragbot/intent_guardrail_jina_retrieval_query_v1.pt"
INTENT_CLASSIFIER_THRESHOLD="0.9489644765853882"
INTENT_CLASSIFIER_DEVICE="cuda"
INTENT_CLASSIFIER_REQUIRED="true"
INTENT_CLASSIFIER_EXPECTED_SHA256="b1fc70b44eb7b1e1b050d87b137adcd669fd05e44d89cee0046e0f727244c87a"
TEI_RERANK_URL="http://localhost:7998"

# ==========================================
# APPLICATION CONCURRENCY AND TIMEOUTS
# ==========================================
APPLICATION_REQUEST_TIMEOUT_SECONDS="50"
REQUEST_CONCURRENCY_LIMIT="256"
REQUEST_ADMISSION_TIMEOUT_SECONDS="45"
BLOCKING_CONCURRENCY_LIMIT="48"

TEI_HTTP_MAX_CONNECTIONS="256"
TEI_HTTP_MAX_KEEPALIVE_CONNECTIONS="128"
TEI_HTTP_KEEPALIVE_EXPIRY_SECONDS="30"
TEI_HTTP_CONNECT_TIMEOUT_SECONDS="3"
TEI_HTTP_READ_TIMEOUT_SECONDS="15"
TEI_HTTP_WRITE_TIMEOUT_SECONDS="5"
TEI_HTTP_POOL_TIMEOUT_SECONDS="15"
# Document-embedding batch for the data-insertion tools; must not exceed TEI_EMBED_MAX_CLIENT_BATCH_SIZE.
TEI_EMBED_INSERT_BATCH_SIZE=32
TEI_EMBED_MAX_CLIENT_BATCH_SIZE=50

VLLM_HTTP_MAX_CONNECTIONS="256"
VLLM_HTTP_MAX_KEEPALIVE_CONNECTIONS="128"
VLLM_HTTP_KEEPALIVE_EXPIRY_SECONDS="30"
VLLM_HTTP_CONNECT_TIMEOUT_SECONDS="3"
VLLM_HTTP_READ_TIMEOUT_SECONDS="60"
VLLM_HTTP_WRITE_TIMEOUT_SECONDS="5"
VLLM_HTTP_POOL_TIMEOUT_SECONDS="15"

QDRANT_CONCURRENCY="32"

# Mass answer (POST /api/mass-answer); rows share the GPU with live chat.
MASS_ANSWER_ROW_CONCURRENCY=4
MASS_ANSWER_ROW_TIMEOUT_SECONDS=50
MASS_ANSWER_DIRECT_MAX_ROWS=20
MASS_ANSWER_JOB_RETENTION_HOURS=24
MASS_ANSWER_MAX_ROWS=5000
MASS_ANSWER_MAX_UPLOAD_MB=10

# ==========================================
# RETRIEVAL AND GENERATION LIMITS
# ==========================================
RAG_QUERY_CANONICALIZATION_ENABLED="true"
RAG_RETRIEVAL_TOP_K="50"
TEI_RERANK_MAX_CLIENT_BATCH_SIZE=50
# Must equal the reranker container's --max-client-batch-size (currently 50). Used only when /info is unavailable. Change both together.
TEI_RERANK_VERIFIED_MAX_BATCH_SIZE=50
TEI_RERANK_CAPABILITY_TTL_SECONDS=600
TEI_RERANK_CAPABILITY_RETRY_SECONDS=30
RAG_BM25_CANDIDATE_LIMIT=50
RAG_SEMANTIC_CANDIDATE_LIMIT="50"
RAG_CONTEXT_RERANK_ENABLED="true"
RAG_CONTEXT_RERANK_TOP_K="10"
RAG_RELATED_QUESTIONS_TOP_K="3"
RAG_RELATED_QUESTIONS_RERANK_THRESHOLD="0.1"
MOBILE_RELATED_QUESTIONS_RERANK_THRESHOLD="0.5"

RAG_MAX_NEW_TOKENS="500"
RAG_CHITCHAT_MAX_NEW_TOKENS="96"
RAG_REWRITE_MAX_TOKENS="128"

# ==========================================
# DETERMINISTIC LLM GENERATION
# ==========================================
RAG_ANSWER_TEMPERATURE=0.0
RAG_ANSWER_TOP_P=1.0
RAG_ANSWER_SEED=42

RAG_CHITCHAT_TEMPERATURE=0.0
RAG_CHITCHAT_TOP_P=1.0
RAG_CHITCHAT_SEED=42

RAG_REWRITE_TEMPERATURE=0.0
RAG_REWRITE_TOP_P=1.0
RAG_REWRITE_SEED=42

# ============================================================
# Pipeline terminal debugging
# ============================================================
RAG_PIPELINE_DEBUG=false
RAG_PIPELINE_DEBUG_QUERY=false
RAG_PIPELINE_DEBUG_NORMALIZATION=false
RAG_PIPELINE_DEBUG_HISTORY=false
RAG_PIPELINE_DEBUG_REWRITE=false
RAG_PIPELINE_DEBUG_INTENT=false
RAG_PIPELINE_DEBUG_RETRIEVAL=false
RAG_PIPELINE_DEBUG_RERANK=false
RAG_PIPELINE_DEBUG_CONTEXT=false
RAG_PIPELINE_DEBUG_PROMPT=false
RAG_PIPELINE_DEBUG_ANSWER=false
RAG_PIPELINE_DEBUG_TIMINGS=false
RAG_PIPELINE_DEBUG_CHUNK_MAX_CHARS=1200
RAG_PIPELINE_DEBUG_FULL_CHUNKS=false

# Structured JSON stdout logging. The collector handles forwarding.
LOG_LEVEL=INFO
LOG_FORMAT=json
LOG_SERVICE_NAME=ragbot
LOG_ENVIRONMENT=production
LOG_BODY_MAX_BYTES=32768
LOG_REQUEST_BODY=true
LOG_RESPONSE_BODY=true
LOG_PII_REDACTION=true
# Optional: leave unset to log national codes as [REDACTED].
# Only set this for stable pseudonymous labels; never reuse WEB_SESSION_SECRET.
# LOG_PII_HMAC_SECRET=<OPTIONAL_DEDICATED_SECRET_FROM_SECRET_MANAGER>

# Knowledge-coverage check (coverage_check/); on unless false, in every environment. Access is by role: admin starts checks, dashboard_viewer views them. Set false to turn it off.
KNOWLEDGE_COVERAGE_ENABLED=true
# Private run folders; absolute, outside the repository and not under /tmp.
KNOWLEDGE_COVERAGE_ARTIFACT_DIR=/root/projects/faq-private/knowledge-coverage
# Largest CSV upload in bytes; integer 1024–20971520.
KNOWLEDGE_COVERAGE_UPLOAD_MAX_BYTES=5242880
# Most CSV rows per check; integer 1–100000.
KNOWLEDGE_COVERAGE_MAX_ROWS=10000
# Page defaults, editable per run: retrieval depth (1–1000), chunks kept after rerank (1 to the depth), chunks per model call (1–20).
KNOWLEDGE_COVERAGE_DEPTH=150
KNOWLEDGE_COVERAGE_KEEP=50
KNOWLEDGE_COVERAGE_BATCH_SIZE=5
# Page defaults for the wider search when a question is not answered: on or off, depth (greater than DEPTH, at most 1000), chunks kept (1–1000).
KNOWLEDGE_COVERAGE_BROADER_ENABLED=false
KNOWLEDGE_COVERAGE_BROADER_DEPTH=200
KNOWLEDGE_COVERAGE_BROADER_KEEP=50
# Most partial chunks sent to the one combine call; integer 2–20.
KNOWLEDGE_COVERAGE_COMBINE_MAX=10
# Characters of each chunk sent to the model; integer 500–20000.
KNOWLEDGE_COVERAGE_CHUNK_MAX_CHARS=4000
# Output tokens per model call; integer 64–2048.
KNOWLEDGE_COVERAGE_MODEL_MAX_TOKENS=300
# Saved chunks given to the model when it drafts a suggested FAQ entry for an unanswered row; integer 1–20.
KNOWLEDGE_COVERAGE_SUGGEST_CONTEXT=5
# Output tokens per suggestion; integer 128–2048.
KNOWLEDGE_COVERAGE_SUGGEST_MAX_TOKENS=700
