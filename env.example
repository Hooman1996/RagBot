# ==========================================
# APPLICATION
# ==========================================
ENVIRONMENT="development"
API_HOST="0.0.0.0"
API_PORT="7000"

# ==========================================
# QDRANT
# ==========================================
QDRANT_URL="http://localhost:6333"
QDRANT_HOST="localhost"
QDRANT_PORT="6333"
QDRANT_API_KEY=CHANGE_ME_QDRANT_API_KEY
QDRANT_COLLECTION="hihelp_embeddings"
QDRANT_VECTOR_SIZE="1024"
QDRANT_HTTPS="False"

# ==========================================
# POSTGRESQL
# ==========================================
POSTGRES_HOST="localhost"
POSTGRES_PORT="5432"
POSTGRES_DB="hihelp_db"
POSTGRES_USER=CHANGE_ME_POSTGRES_USER
POSTGRES_PASSWORD=CHANGE_ME_POSTGRES_PASSWORD

DEFAULT_DB_HOST="localhost"
DEFAULT_DB_PORT="5432"
DEFAULT_DB_USER=CHANGE_ME_POSTGRES_USER
DEFAULT_DB_PASSWORD=CHANGE_ME_DEFAULT_DB_PASSWORD
DEFAULT_DB_NAME="mydb"

# ==========================================
# MINIO
# ==========================================
MINIO_ENDPOINT="localhost:9000"
MINIO_ACCESS_KEY=CHANGE_ME_MINIO_ACCESS_KEY
MINIO_SECRET_KEY=CHANGE_ME_MINIO_SECRET_KEY
MINIO_SECURE="False"
MINIO_BUCKET="hihelp-documents"

# ==========================================
# INFERENCE SERVICES / MODELS
# ==========================================
VLLM_URL="http://localhost:8765/v1"
TEI_EMBED_URL="http://localhost:7997"
TEI_RERANK_URL="http://localhost:7998"

EMBEDDING_MODEL="/root/models/models--jinaai--jina-embeddings-v5-text-small-retrieval"
QUERY_EMBEDDING_MODEL="/root/models/models--jinaai--jina-embeddings-v5-text-small-retrieval"

# Same served model name in DEV and PROD
LLM_MODEL="gemma-4-12B-it"

RERANKER_MODEL="/root/models/BAAI--bge-reranker-v2-m3"

KNOWLEDGE_BASE_CSV="/root/projects/faq/General_FAQ.csv"
DATA_INSERTION_DIRECTORY="/root/projects/faq/data_insertion_chunks"

# ==========================================
# INTENT CLASSIFIER
# ==========================================
INTENT_CLASSIFIER_MODEL_PATH="/root/projects/faq/training/artifacts/intent_guardrail_jina_retrieval_query_v1.pt"
INTENT_CLASSIFIER_THRESHOLD="0.9489644765853882"
INTENT_CLASSIFIER_DEVICE="cuda"
INTENT_CLASSIFIER_REQUIRED="true"
INTENT_CLASSIFIER_EXPECTED_SHA256="b1fc70b44eb7b1e1b050d87b137adcd669fd05e44d89cee0046e0f727244c87a"

# ==========================================
# APPLICATION CAPACITY
# ==========================================
APPLICATION_REQUEST_TIMEOUT_SECONDS="50"

# 48 GB shared-GPU development host
REQUEST_CONCURRENCY_LIMIT="100"
REQUEST_ADMISSION_TIMEOUT_SECONDS="12"
BLOCKING_CONCURRENCY_LIMIT="16"

# ==========================================
# TEI HTTP CLIENT
# ==========================================
TEI_HTTP_MAX_CONNECTIONS="128"
TEI_HTTP_MAX_KEEPALIVE_CONNECTIONS="64"
TEI_HTTP_KEEPALIVE_EXPIRY_SECONDS="30"

TEI_HTTP_CONNECT_TIMEOUT_SECONDS="3"
TEI_HTTP_READ_TIMEOUT_SECONDS="15"
TEI_HTTP_WRITE_TIMEOUT_SECONDS="5"
TEI_HTTP_POOL_TIMEOUT_SECONDS="5"

# ==========================================
# VLLM HTTP CLIENT
# ==========================================
VLLM_HTTP_MAX_CONNECTIONS="128"
VLLM_HTTP_MAX_KEEPALIVE_CONNECTIONS="64"
VLLM_HTTP_KEEPALIVE_EXPIRY_SECONDS="30"

VLLM_HTTP_CONNECT_TIMEOUT_SECONDS="3"
VLLM_HTTP_READ_TIMEOUT_SECONDS="40"
VLLM_HTTP_WRITE_TIMEOUT_SECONDS="5"
VLLM_HTTP_POOL_TIMEOUT_SECONDS="5"

# ==========================================
# QDRANT
# ==========================================
QDRANT_CONCURRENCY="8"

# ==========================================
# QUERY / RETRIEVAL
# ==========================================
RAG_QUERY_CANONICALIZATION_ENABLED="true"

RAG_RETRIEVAL_TOP_K="50"
TEI_RERANK_MAX_CLIENT_BATCH_SIZE=50
# Must equal the reranker container's --max-client-batch-size (currently 50). Used only when /info is unavailable. Change both together.
TEI_RERANK_VERIFIED_MAX_BATCH_SIZE=50
TEI_RERANK_CAPABILITY_TTL_SECONDS=600
TEI_RERANK_CAPABILITY_RETRY_SECONDS=30
RAG_BM25_CANDIDATE_LIMIT=50
RAG_SEMANTIC_CANDIDATE_LIMIT="50"

RAG_CONTEXT_RERANK_ENABLED="true"
RAG_CONTEXT_RERANK_TOP_K="10"

RAG_RELATED_QUESTIONS_TOP_K="3"
RAG_RELATED_QUESTIONS_RERANK_THRESHOLD="0.1"
MOBILE_RELATED_QUESTIONS_RERANK_THRESHOLD="0.5"

# ==========================================
# GENERATION LIMITS
# IDENTICAL TO PROD
# ==========================================
RAG_MAX_NEW_TOKENS="500"
RAG_CHITCHAT_MAX_NEW_TOKENS="96"
RAG_REWRITE_MAX_TOKENS="128"

# ==========================================
# DETERMINISTIC GENERATION
# IDENTICAL TO PROD
# ==========================================
RAG_ANSWER_TEMPERATURE="0.0"
RAG_ANSWER_TOP_P="1.0"
RAG_ANSWER_SEED="42"

RAG_CHITCHAT_TEMPERATURE="0.0"
RAG_CHITCHAT_TOP_P="1.0"
RAG_CHITCHAT_SEED="42"

RAG_REWRITE_TEMPERATURE="0.0"
RAG_REWRITE_TOP_P="1.0"
RAG_REWRITE_SEED="42"


# ============================================================
# Pipeline terminal debugging
# ============================================================
RAG_PIPELINE_DEBUG=false
RAG_PIPELINE_DEBUG_QUERY=true
RAG_PIPELINE_DEBUG_NORMALIZATION=true
RAG_PIPELINE_DEBUG_HISTORY=true
RAG_PIPELINE_DEBUG_REWRITE=true
RAG_PIPELINE_DEBUG_INTENT=true
RAG_PIPELINE_DEBUG_RETRIEVAL=true
RAG_PIPELINE_DEBUG_RERANK=true
RAG_PIPELINE_DEBUG_CONTEXT=true
RAG_PIPELINE_DEBUG_PROMPT=false
RAG_PIPELINE_DEBUG_ANSWER=true
RAG_PIPELINE_DEBUG_TIMINGS=true
RAG_PIPELINE_DEBUG_CHUNK_MAX_CHARS=1200
RAG_PIPELINE_DEBUG_FULL_CHUNKS=false

# Browser sessions (set the external HTTPS origin in staging/production).
WEB_ENVIRONMENT=production
WEB_COOKIE_MODE=https
WEB_PUBLIC_ORIGIN=https://ragbot.example.invalid
WEB_SESSION_SECONDS=900
WEB_SESSION_SECRET=CHANGE_ME_WEB_SESSION_SECRET
# Local VS Code Remote-SSH: WEB_ENVIRONMENT=development, WEB_COOKIE_MODE=local-http,
# WEB_PUBLIC_ORIGIN=http://localhost:8765. Production must use an HTTPS origin.

# Structured JSON stdout logging. The collector handles forwarding.
LOG_LEVEL=INFO
LOG_FORMAT=json
LOG_SERVICE_NAME=ragbot
LOG_ENVIRONMENT=production
LOG_BODY_MAX_BYTES=32768
LOG_REQUEST_BODY=true
LOG_RESPONSE_BODY=true
LOG_PII_REDACTION=true
# Optional: leave unset to log national codes as [REDACTED].
# Only set this for stable pseudonymous labels; never reuse WEB_SESSION_SECRET.
# LOG_PII_HMAC_SECRET=<OPTIONAL_DEDICATED_SECRET_FROM_SECRET_MANAGER>

# A2 private knowledge-coverage pilot; audit capabilities default to deny.
# Audit runs only when this is true AND ENVIRONMENT=staging; production refuses to start with it true.
KNOWLEDGE_COVERAGE_ENABLED=false
KNOWLEDGE_COVERAGE_ARTIFACT_DIR=/root/projects/faq-private/knowledge-coverage
# A4 review is also default denied; grant coverage_recommendation_review explicitly to approved owners only.
KNOWLEDGE_COVERAGE_ACCESS_GRANTS={}
KNOWLEDGE_COVERAGE_UPLOAD_MAX_BYTES=5242880
KNOWLEDGE_COVERAGE_MODEL_MAX_TOKENS=1200
KNOWLEDGE_COVERAGE_TOKEN_MARGIN=128
# Audit-local batch cap; integer 1-5. Token packing may select fewer.
KNOWLEDGE_COVERAGE_BATCH_MAX_ENTRIES=2

# Maximum selected audit rows per run (5–100000); pilot default stays five.
KNOWLEDGE_COVERAGE_MAX_RUN_ROWS=10000

# A6.2 finite audit allowances and manual retention; no production policy changes.
# Reserved completion attempts across all recovery attempts; integer 1–100000.
KNOWLEDGE_COVERAGE_MAX_COMPLETIONS=200
# Conservative completion prompt plus maximum output token allowance; integer 1–1000000000.
KNOWLEDGE_COVERAGE_MAX_TOKENS=1000000
# Cumulative execution seconds; abandoned active intervals include downtime; integer 1–604800.
KNOWLEDGE_COVERAGE_MAX_EXECUTION_SECONDS=3600
# Consecutive service/model failures before pause; integer 1–100.
KNOWLEDGE_COVERAGE_MAX_CONSECUTIVE_FAILURES=3
# Minimum free artifact filesystem bytes before dispatch; integer 0–1099511627776.
KNOWLEDGE_COVERAGE_MIN_FREE_BYTES=1073741824
# Audit-local delay before shared admission in milliseconds; integer 0–60000.
KNOWLEDGE_COVERAGE_PACE_MS=500
# Separate completion allowance per recommendation revision; integer 1–10000.
KNOWLEDGE_RECOMMENDATION_MAX_COMPLETIONS=20
# Manual cleanup age threshold; automatic deletion is always disabled; integer 1–3650.
KNOWLEDGE_COVERAGE_RETENTION_DAYS=30
# Audit initial retrieval depth (BM25, semantic and top-k); reranking batches it to the TEI limit; changing it changes audit results; integer 1–1000.
KNOWLEDGE_COVERAGE_INITIAL_DEPTH=150
# Audit broader retrieval depth when initial evidence is not full; must exceed the initial depth; changing it changes audit results; integer 2–1000.
KNOWLEDGE_COVERAGE_BROADER_DEPTH=300
# Entries kept from the reranked initial pool; at most the initial depth; changing it changes audit results; integer 1–1000.
KNOWLEDGE_COVERAGE_INITIAL_ENTRIES=50
# Maximum distinct entries per question and default run entry budget; changing it changes audit results; integer 1–1000.
KNOWLEDGE_COVERAGE_MAX_ENTRY_BUDGET=300
# Verification passes per accepted proof: 2 re-verifies it in reversed evidence order and accepts only if both agree; changing it changes audit results and cost; integer 1–2.
KNOWLEDGE_COVERAGE_VERIFICATION_PASSES=2
# Evaluate a repeated question once per run: a later identical row with the same prior turns copies the earlier completed result; changes audit cost, not verdicts; true or false.
KNOWLEDGE_COVERAGE_DEDUPE=true
# Official public support emails, @domains and phone numbers kept in KB snapshots; anything else that looks personal is scrubbed.
KNOWLEDGE_COVERAGE_PUBLIC_CONTACTS=
