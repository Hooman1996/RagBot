# RagBot safe environment template
# Generated from repository consumers, not from the current .env values.
# Copy this file to a local, untracked .env and replace every "change-me".

# ---------------------------------------------------------------------------
# Application / direct `python main.py` entry point
# ---------------------------------------------------------------------------

# Deployment label. Required: no. Allowed: development, staging, production.
# Note: currently not consumed by application code.
ENVIRONMENT=staging

# Uvicorn bind address. Required: no. Default: 0.0.0.0.
API_HOST=0.0.0.0

# Uvicorn bind port. Required: no. Integer, 1-65535. Default: 8080.
API_PORT=8080

# ---------------------------------------------------------------------------
# Qdrant vector database
# ---------------------------------------------------------------------------

# Deprecated full URL. Required: no. Active FastAPI code ignores it.
QDRANT_URL=

# Qdrant host name. Required: no. Default: localhost.
QDRANT_HOST=localhost

# Qdrant API port. Required: no. Integer, 1-65535. Default: 6333.
QDRANT_PORT=6333

# Qdrant API key. Required: production policy only. Secret: yes.
QDRANT_API_KEY=change-me

# Collection containing RagBot vectors. Required: no.
QDRANT_COLLECTION=hihelp_embeddings

# Embedding vector length. Required: no. Must match TEI and the collection.
QDRANT_VECTOR_SIZE=1024

# Use HTTPS for Qdrant. Required: no. Allowed: true or false.
QDRANT_HTTPS=false

# ---------------------------------------------------------------------------
# PostgreSQL target database used by FastAPI
# ---------------------------------------------------------------------------

# Required: yes for FastAPI.
POSTGRES_HOST=localhost

# Required: yes for FastAPI. Integer, 1-65535.
POSTGRES_PORT=5432

# Required: yes for FastAPI.
POSTGRES_DB=ragbot

# Required: yes for FastAPI. Secret/internal credential: yes.
POSTGRES_USER=change-me

# Required: yes for FastAPI. Secret: yes.
POSTGRES_PASSWORD=change-me

# ---------------------------------------------------------------------------
# Database setup administrator connection
# Used only by new_architecture/setup_dbs.py
# ---------------------------------------------------------------------------

# Required only for database setup.
DEFAULT_DB_HOST=localhost
DEFAULT_DB_PORT=5432
DEFAULT_DB_NAME=postgres

# Required only for database setup. Secret/internal credential: yes.
DEFAULT_DB_USER=change-me

# Required only for database setup. Secret: yes.
DEFAULT_DB_PASSWORD=change-me

# ---------------------------------------------------------------------------
# MinIO object storage
# ---------------------------------------------------------------------------

# Host and port without http:// or https://. Default: localhost:9000.
MINIO_ENDPOINT=localhost:9000

# Required: yes for FastAPI. Secret: yes.
MINIO_ACCESS_KEY=change-me

# Required: yes for FastAPI. Secret: yes.
MINIO_SECRET_KEY=change-me

# TLS flag. Allowed: true or false.
# Warning: active FastAPI Config currently hardcodes false and ignores this.
MINIO_SECURE=false

# Required: yes for FastAPI.
MINIO_BUCKET=ragbot-documents

# ---------------------------------------------------------------------------
# vLLM and Hugging Face TEI endpoints
# ---------------------------------------------------------------------------

# OpenAI-compatible vLLM base URL. Default: http://localhost:8000/v1.
VLLM_URL=http://localhost:8000/v1

# TEI embedding service base URL. Required: yes for FastAPI.
# Staging architecture uses the embedding service on port 7997.
TEI_EMBED_URL=http://127.0.0.1:7997

# TEI reranker service base URL. Required: yes for FastAPI.
# Staging architecture uses the reranker service on port 7998.
TEI_RERANK_URL=http://127.0.0.1:7998

# Legacy model metadata. These do not select the models served by vLLM/TEI.
# Required: no.
EMBEDDING_MODEL=
LLM_MODEL=
RERANKER_MODEL=

# Deprecated alias used only by an inactive local embedding service.
EMBEDDING_MODEL_NAME=

# ---------------------------------------------------------------------------
# Data preparation and insertion commands
# ---------------------------------------------------------------------------

# Required only by hihelp_knowledge_changer.py.
KNOWLEDGE_BASE_CSV=/path/to/synthetic-knowledge-base.csv

# Required only by new_architecture/insert_data.py and
# new_architecture/data_insertion_with_api.py.
DATA_INSERTION_DIRECTORY=/path/to/ragbot-data

# Number of documents sent in one TEI insertion call. Default: 32.
TEI_EMBED_INSERT_BATCH_SIZE=32

# Known TEI client-side batch ceiling. Default: 50.
# The insertion batch size must not exceed this value.
TEI_EMBED_MAX_CLIENT_BATCH_SIZE=50

# ---------------------------------------------------------------------------
# Total request deadline and application concurrency
# ---------------------------------------------------------------------------

# Total endpoint deadline in seconds. Default and maximum: 50.
APPLICATION_REQUEST_TIMEOUT_SECONDS=50

# Simultaneous admitted application operations. Default: 32.
REQUEST_CONCURRENCY_LIMIT=32

# Maximum wait for an application slot, in seconds. Default: 12.
REQUEST_ADMISSION_TIMEOUT_SECONDS=12

# Maximum synchronous jobs offloaded from async code. Default: 16.
BLOCKING_CONCURRENCY_LIMIT=16

# ---------------------------------------------------------------------------
# TEI HTTP client pool and timeouts
# ---------------------------------------------------------------------------

# Positive integers. Keep-alive connections must not exceed max connections.
TEI_HTTP_MAX_CONNECTIONS=32
TEI_HTTP_MAX_KEEPALIVE_CONNECTIONS=16

# Positive seconds.
TEI_HTTP_KEEPALIVE_EXPIRY_SECONDS=30
TEI_HTTP_CONNECT_TIMEOUT_SECONDS=3
TEI_HTTP_READ_TIMEOUT_SECONDS=15
TEI_HTTP_WRITE_TIMEOUT_SECONDS=5
TEI_HTTP_POOL_TIMEOUT_SECONDS=3

# ---------------------------------------------------------------------------
# vLLM HTTP client pool and timeouts
# ---------------------------------------------------------------------------

# Positive integers. Keep-alive connections must not exceed max connections.
VLLM_HTTP_MAX_CONNECTIONS=32
VLLM_HTTP_MAX_KEEPALIVE_CONNECTIONS=16

# Positive seconds.
VLLM_HTTP_KEEPALIVE_EXPIRY_SECONDS=30
VLLM_HTTP_CONNECT_TIMEOUT_SECONDS=3
VLLM_HTTP_READ_TIMEOUT_SECONDS=45
VLLM_HTTP_WRITE_TIMEOUT_SECONDS=5
VLLM_HTTP_POOL_TIMEOUT_SECONDS=3

# ---------------------------------------------------------------------------
# Retrieval and generation
# ---------------------------------------------------------------------------

# Concurrent Qdrant searches per process. Positive integer. Default: 4.
QDRANT_CONCURRENCY=4

# Returned results and pre-rerank candidates. Positive integers.
# RAG_RETRIEVAL_TOP_K must not exceed RAG_SEMANTIC_CANDIDATE_LIMIT.
RAG_RETRIEVAL_TOP_K=10
RAG_SEMANTIC_CANDIDATE_LIMIT=50

# Rerank score thresholds. Floats from 0 through 1.
RAG_RELATED_QUESTIONS_RERANK_THRESHOLD=0.1
MOBILE_RELATED_QUESTIONS_RERANK_THRESHOLD=0.5

# Maximum generated tokens. Positive integers.
RAG_MAX_NEW_TOKENS=500
RAG_CHITCHAT_MAX_NEW_TOKENS=200
RAG_REWRITE_MAX_TOKENS=1000

# ---------------------------------------------------------------------------
# Inactive SQLAlchemy pool (not on the verified FastAPI startup path)
# ---------------------------------------------------------------------------

SQLALCHEMY_POOL_SIZE=5
SQLALCHEMY_MAX_OVERFLOW=10
SQLALCHEMY_POOL_TIMEOUT=30
SQLALCHEMY_POOL_RECYCLE=3600
SQLALCHEMY_ECHO=false

# ---------------------------------------------------------------------------
# Staging load-test-only settings
# Do not store a real token in a tracked file.
# ---------------------------------------------------------------------------

# Optional bearer token. Secret: yes. Staging only.
RAGBOT_STAGING_AUTH_TOKEN=change-me

# Optional report metadata. Staging only.
RAGBOT_STAGING_LIMITER_CAPACITY=unknown
RAGBOT_STAGING_GPU_INFO=unknown
RAGBOT_VLLM_IMAGE=unknown
RAGBOT_TEI_EMBED_IMAGE=unknown
RAGBOT_TEI_RERANK_IMAGE=unknown
