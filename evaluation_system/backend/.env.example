# Safe local-development example. Replace every placeholder outside local use.
EVAL_ENABLED=true
EVAL_API_HOST=0.0.0.0
EVAL_API_PORT=8090

# PostgreSQL must be reachable by both the API and worker processes.
POSTGRES_HOST=127.0.0.1
POSTGRES_PORT=5432
POSTGRES_DB=eval_local
POSTGRES_USER=eval_local
POSTGRES_PASSWORD=replace-with-a-local-password

# Initialization is explicit and disabled by default.
EVAL_ALLOW_DB_INIT=false

# Leave empty for the production same-origin Nginx topology. Use a comma-
# separated list only when browsers call the API cross-origin in development.
EVAL_CORS_ORIGINS=http://127.0.0.1:4173

EVAL_SESSION_CONCURRENCY=1
EVAL_REPEAT_MAX=100
EVAL_WORKER_POLL_INTERVAL_SECONDS=1
EVAL_WORKER_STALE_AFTER_SECONDS=300
EVAL_SSE_POLL_INTERVAL_SECONDS=1
EVAL_MAX_UPLOAD_BYTES=20971520
EVAL_MAX_DATASET_ROWS=50000

# Local RagBot example only. Production must use a service URL reachable from
# the Eval backend process/container; container loopback is normally incorrect.
EVAL_RAGBOT_BASE_URL=http://127.0.0.1:7000
EVAL_RAGBOT_HTTP_TIMEOUT_SECONDS=70
