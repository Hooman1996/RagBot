# Copy this file to .env and replace placeholders before rendering Compose.
EVAL_IMAGE_TAG=local
EVAL_FRONTEND_PORT=8088

# Optional build-only package mirror. Production and CI may use an
# infrastructure-approved mirror instead.
# PIP_INDEX_URL=https://mirrors.aliyun.com/pypi/simple/
# NPM_REGISTRY_URL=https://mirrors.cloud.tencent.com/npm/

# These addresses are examples only. Both services must be reachable from the
# Eval containers; container loopback addresses will not reach external hosts.
POSTGRES_HOST=postgres.internal
POSTGRES_PORT=5432
POSTGRES_DB=ragbot_evaluation
POSTGRES_USER=eval_user
POSTGRES_PASSWORD=replace-with-a-secret

EVAL_ALLOW_DB_INIT=false

# Same-origin Browser -> Nginx -> Eval API traffic does not require CORS.
EVAL_CORS_ORIGINS=

EVAL_SESSION_CONCURRENCY=1
EVAL_REPEAT_MAX=100

EVAL_WORKER_POLL_INTERVAL_SECONDS=1
EVAL_WORKER_STALE_AFTER_SECONDS=300

EVAL_SSE_POLL_INTERVAL_SECONDS=1

EVAL_MAX_UPLOAD_BYTES=20971520
EVAL_MAX_DATASET_ROWS=50000

EVAL_RAGBOT_BASE_URL=http://ragbot.internal:8080
EVAL_RAGBOT_HTTP_TIMEOUT_SECONDS=70
