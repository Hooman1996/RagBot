# Measured application-side baseline for the single RTX 5880 staging host.
#
# The admission and HTTP-capacity values passed five 50-request waves on
# 2026-07-29 with the exact model-server configuration documented in
# docs/configuration/RTX5880_FINAL_RECOMMENDATIONS.md.
# Do not copy this partial file over .env: it intentionally omits secrets and
# service addresses. Apply the changed lines to the approved configuration
# source and restart every FastAPI worker.
# This file intentionally contains no credentials, service URLs, or private
# network details. Keep those in the existing approved secret/config source.

# Total mobile request deadline, seconds. Repository maximum: 50.
APPLICATION_REQUEST_TIMEOUT_SECONDS=50

# Per-FastAPI-worker admission and blocking limits.
REQUEST_CONCURRENCY_LIMIT=50
REQUEST_ADMISSION_TIMEOUT_SECONDS=12
BLOCKING_CONCURRENCY_LIMIT=16

# Shared FastAPI-to-TEI HTTP client. All durations are seconds.
TEI_HTTP_MAX_CONNECTIONS=64
TEI_HTTP_MAX_KEEPALIVE_CONNECTIONS=16
TEI_HTTP_KEEPALIVE_EXPIRY_SECONDS=30
TEI_HTTP_CONNECT_TIMEOUT_SECONDS=3
TEI_HTTP_READ_TIMEOUT_SECONDS=15
TEI_HTTP_WRITE_TIMEOUT_SECONDS=5
TEI_HTTP_POOL_TIMEOUT_SECONDS=5

# Shared FastAPI-to-vLLM HTTP client. All durations are seconds.
VLLM_HTTP_MAX_CONNECTIONS=64
VLLM_HTTP_MAX_KEEPALIVE_CONNECTIONS=16
VLLM_HTTP_KEEPALIVE_EXPIRY_SECONDS=30
VLLM_HTTP_CONNECT_TIMEOUT_SECONDS=3
VLLM_HTTP_READ_TIMEOUT_SECONDS=40
VLLM_HTTP_WRITE_TIMEOUT_SECONDS=5
VLLM_HTTP_POOL_TIMEOUT_SECONDS=3

# Per-FastAPI-worker vector-search limit.
QDRANT_CONCURRENCY=8

# Retrieval settings retained at the tested live values. Quality testing is
# mandatory before changing these.
RAG_RETRIEVAL_TOP_K=10
RAG_SEMANTIC_CANDIDATE_LIMIT=50
RAG_RELATED_QUESTIONS_RERANK_THRESHOLD=0.1

# Generation ceilings retained at the tested live values, in tokens.
# Quality testing is mandatory before reducing or increasing them.
RAG_MAX_NEW_TOKENS=500
RAG_CHITCHAT_MAX_NEW_TOKENS=128
RAG_REWRITE_MAX_TOKENS=200

# Data-insertion batching; not used by the mobile request path.
TEI_EMBED_INSERT_BATCH_SIZE=32
TEI_EMBED_MAX_CLIENT_BATCH_SIZE=50
